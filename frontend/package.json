{
  "name": "strat-matrix-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "16.13.0", "npm": ">=8.1.0 <9" },
  "packageManager": "npm@8.1.0",
  "scripts": {
    "preinstall": "node tooling/checkNode.cjs",
    "predev": "node tooling/checkNode.cjs",
    "pretest": "node tooling/checkNode.cjs",
    "prebuild": "node tooling/checkNode.cjs",
    "prepreview": "node tooling/checkNode.cjs",
    "dev": "vite",
    "test": "mocha --parallel --jobs 2 --require ./tests/helpers/node16.cjs \"tests/*.test.cjs\"",
