    "vuex": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "16.11.7",
    "browserslist": "4.24.5",
    "mocha": "10.8.2",
    "node-releases": "2.0.19",
    "typescript": "5.9.3",
    "vite": "4.5.14",
    "vite-plugin-vue2": "2.0.3",
    "vue-server-renderer": "2.6.14",
    "vue-template-compiler": "2.6.14",
    "vue-tsc": "2.2.12"
