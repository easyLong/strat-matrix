server {
    listen 80;
    server_name your-domain.example.com;

    location /api/ {
        # Local three-project development deployment. Host integration replaces this upstream.
        # Browser /api/query/plans -> Java /api/plan/query/plans.
        # Python legacy forwarding is temporary and only enabled in the local profile.
        proxy_pass http://127.0.0.1:6931/api/plan/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:930;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
