      "@PostMapping(\"/versions/{version}/restore\")"
    ],
    "ConfigReleaseController": [
      "@RequestMapping(\"${planning.api-prefix:/api/plan}/config\")",
      "@GetMapping",
      "@PutMapping",
      "@GetMapping(\"/versions\")",
      "@PostMapping(\"/versions/{version}/restore\")"
    ],
    "TagTaxonomyController": [
      "@RequestMapping(\"${planning.api-prefix:/api/plan}/tag-taxonomy\")",
      "@GetMapping",
      "@PutMapping"
    ],
    "SourceFactsController": [
      "@RequestMapping(\"${planning.source.api-prefix:/api/plan/internal/source}\")",
      "@PostMapping(\"/{capability}/query\")"
    ],
    "PlanningHealthController": [
      "@RequestMapping(\"${planning.api-prefix:/api/plan}\")",
      "@GetMapping(\"/health\")"
    ]
  },
