<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pab.aitmp.aiis.godp.planning.services.query.PlanningQueryMapper">
  <resultMap id="archivedTaskRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PayloadRow" autoMapping="false">
    <result column="payload" property="payload"/>
  </resultMap>

  <resultMap id="latestOperationsRow" type="com.pab.aitmp.aiis.godp.planning.entity.entity.PlanningAdjustmentEntity" autoMapping="false">
    <result column="id" property="id"/>
    <result column="del_flag" property="delFlag"/>
    <result column="created_by" property="createdBy"/>
    <result column="updated_by" property="updatedBy"/>
    <result column="created_time" property="createdTime"/>
    <result column="updated_time" property="updatedTime"/>
    <result column="item_id" property="itemId"/>
    <result column="payload" property="payload"/>
  </resultMap>

  <resultMap id="tasksRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PlanningTaskReadRow" autoMapping="false">
    <result column="row_key" property="rowKey"/>
    <result column="kind" property="kind"/>
    <result column="payload" property="payload"/>
    <result column="task_name" property="taskName"/>
    <result column="batch_code" property="batchCode"/>
    <result column="publish_date" property="publishDate"/>
    <result column="created_by" property="createdBy"/>
    <result column="content_status" property="contentStatus"/>
    <result column="id" property="id"/>
    <result column="created_at" property="createdAt"/>
  </resultMap>

  <resultMap id="periodAccountsRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PeriodAccountCountRow" autoMapping="false">
    <result column="week_start" property="weekStart"/>
    <result column="account_count" property="accountCount"/>
    <result column="auto_accounts" property="autoAccounts"/>
    <result column="manual_accounts" property="manualAccounts"/>
    <result column="completed_accounts" property="completedAccounts"/>
  </resultMap>

  <resultMap id="periodBatchesRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PlanningBatchReadRow" autoMapping="false">
    <result column="payload" property="payload"/>
    <result column="week_start" property="weekStart"/>
    <result column="plan_type" property="planType"/>
    <result column="cycle_start" property="cycleStart"/>
    <result column="cycle_end" property="cycleEnd"/>
    <result column="batch_code" property="batchCode"/>
    <result column="task_name" property="taskName"/>
    <result column="id" property="id"/>
    <result column="created_at" property="createdAt"/>
    <result column="account_count" property="accountCount"/>
    <result column="completed_count" property="completedCount"/>
    <result column="failed_count" property="failedCount"/>
    <result column="topic_count" property="topicCount"/>
  </resultMap>

  <resultMap id="periodKeysRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PeriodKeyRow" autoMapping="false">
    <result column="week_start" property="weekStart"/>
  </resultMap>

  <resultMap id="facetsRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.AccountFacetRow" autoMapping="false">
    <result column="organization" property="organization"/>
    <result column="platform" property="platform"/>
    <result column="lifecycle_stage" property="lifecycleStage"/>
  </resultMap>

  <resultMap id="accountSnapshotsRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PlanningItemReadRow" autoMapping="false">
    <result column="slot_id" property="slotId"/>
    <result column="account_id" property="accountId"/>
    <result column="publish_date" property="publishDate"/>
    <result column="publish_week" property="publishWeek"/>
    <result column="payload" property="payload"/>
    <result column="content_status" property="contentStatus"/>
    <result column="runtime_active" property="runtimeActive"/>
    <result column="plan_type" property="planType"/>
    <result column="cycle_start" property="cycleStart"/>
    <result column="cycle_end" property="cycleEnd"/>
    <result column="topic_id" property="topicId"/>
    <result column="topic_type" property="topicType"/>
    <result column="content_type" property="contentType"/>
    <result column="slot_type" property="slotType"/>
    <result column="content_role" property="contentRole"/>
    <result column="account_name" property="accountName"/>
    <result column="owner_um" property="ownerUm"/>
    <result column="organization" property="organization"/>
    <result column="platform" property="platform"/>
    <result column="account_type" property="accountType"/>
    <result column="lifecycle_stage" property="lifecycleStage"/>
    <result column="id" property="id"/>
    <result column="batch_id" property="batchId"/>
    <result column="version" property="version"/>
    <result column="sort_millis" property="sortMillis"/>
    <result column="followers" property="followers"/>
  </resultMap>

  <resultMap id="accountGroupsRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.AccountGroupRow" autoMapping="false">
    <result column="account_id" property="accountId"/>
    <result column="slot_count" property="slotCount"/>
    <result column="cycle_count" property="cycleCount"/>
    <result column="latest_time" property="latestTime"/>
  </resultMap>

  <resultMap id="distributionRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.ContentTypeCountRow" autoMapping="false">
    <result column="name" property="name"/>
    <result column="amount" property="amount"/>
  </resultMap>

  <resultMap id="summaryRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PlanSummaryRow" autoMapping="false">
    <result column="accounts" property="accounts"/>
    <result column="batches" property="batches"/>
    <result column="topics" property="topics"/>
  </resultMap>

  <resultMap id="groupKeysRow" type="com.pab.aitmp.aiis.godp.planning.entity.row.PlanGroupRow" autoMapping="false">
    <result column="group_key" property="groupKey"/>
    <result column="last_date" property="lastDate"/>
    <result column="last_id" property="lastId"/>
  </resultMap>

 <sql id="scope">
  WHERE 1=1
  <if test="mode=='batch'">AND batch_id=#{batchId}</if>
  <if test="mode=='account'">AND account_id=#{accountId}</if>
  <if test="mode=='cycle'">AND cycle_start BETWEEN #{cycleStart} AND #{cycleEnd}</if>
  <if test="start!=null and start!=''">AND publish_date&gt;=#{start}</if>
  <if test="end!=null and end!=''">AND publish_date&lt;=#{end}</if>
  <if test="planType!=null and planType!='' and planType!='all'">AND plan_type=#{planType}</if>
  <if test="contentType!=null and contentType!='' and contentType!='all'">AND content_type=#{contentType}</if>
  <if test="account!=null and account!=''">AND (LOCATE(LOWER(#{account}),LOWER(account_id))&gt;0 OR LOCATE(LOWER(#{account}),LOWER(account_name))&gt;0)</if>
  <if test="um!=null and um!=''">AND LOCATE(LOWER(#{um}),LOWER(owner_um))&gt;0</if>
  <if test="organization!=null and organization!=''">AND organization=#{organization}</if>
  <if test="platform!=null and platform!=''">AND platform=#{platform}</if>
  <if test="lifecycle!=null and lifecycle!=''">AND lifecycle_stage=#{lifecycle}</if>
  <if test="accountType!=null and accountType!=''">AND account_type=#{accountType}</if>
  <if test="followersMin!=null">AND followers&gt;=#{followersMin}</if>
  <if test="followersMax!=null">AND followers&lt;=#{followersMax}</if>
  <if test="accountIds!=null">AND account_id IN <foreach collection="accountIds" item="a" open="(" close=")" separator=",">#{a}</foreach></if>
  <if test="batchIds!=null">AND batch_id IN <foreach collection="batchIds" item="b" open="(" close=")" separator=",">#{b}</foreach></if>
 </sql>
 <sql id="groupExpression"><choose><when test="unit=='records'">CAST(id AS CHAR(32))</when><when test="mode=='account'">publish_week</when><otherwise>account_id</otherwise></choose></sql>
 <select id="groupCount" resultType="long">SELECT COUNT(DISTINCT <include refid="groupExpression"/>) FROM godp_planning_item_read <include refid="scope"/></select>
 <select id="groupKeys" resultMap="groupKeysRow">SELECT <include refid="groupExpression"/> AS group_key,MAX(publish_date) last_date,MAX(id) last_id FROM godp_planning_item_read <include refid="scope"/> GROUP BY <include refid="groupExpression"/> ORDER BY last_date DESC,last_id DESC LIMIT #{limit} OFFSET #{offset}</select>
 <select id="records" resultMap="accountSnapshotsRow">SELECT * FROM godp_planning_item_read <include refid="scope"/>
  <if test="keys!=null">AND <include refid="groupExpression"/> IN <foreach collection="keys" item="k" open="(" close=")" separator=",">#{k}</foreach></if>
  <if test="afterId!=null">AND id&gt;#{afterId}</if>
  ORDER BY <choose><when test="afterId!=null">id</when><otherwise>publish_date DESC,id DESC</otherwise></choose>
  <if test="limit!=null">LIMIT #{limit}</if>
 </select>
 <select id="summary" resultMap="summaryRow">SELECT COUNT(DISTINCT account_id) accounts,COUNT(DISTINCT batch_id) batches,COUNT(DISTINCT NULLIF(topic_id,'')) topics FROM godp_planning_item_read <include refid="scope"/></select>
 <select id="distribution" resultMap="distributionRow">SELECT content_type name,COUNT(DISTINCT topic_id) amount FROM godp_planning_item_read <include refid="scope"/> AND topic_id&lt;&gt;'' AND content_type&lt;&gt;'' GROUP BY content_type</select>
 <select id="accountCount" resultType="long">SELECT COUNT(DISTINCT account_id) FROM godp_planning_item_read <include refid="scope"/></select>
 <select id="accountGroups" resultMap="accountGroupsRow">SELECT account_id,COUNT(*) slot_count,COUNT(DISTINCT cycle_start) cycle_count,MAX(sort_millis) latest_time FROM godp_planning_item_read <include refid="scope"/> GROUP BY account_id ORDER BY latest_time DESC,account_id LIMIT #{limit} OFFSET #{offset}</select>
 <select id="accountSnapshots" resultMap="accountSnapshotsRow">SELECT r.* FROM godp_planning_item_read r JOIN (SELECT account_id,MAX(id) latest FROM godp_planning_item_read WHERE account_id IN <foreach collection="ids" item="a" open="(" close=")" separator=",">#{a}</foreach> GROUP BY account_id) t ON r.id=t.latest</select>
 <select id="facets" resultMap="facetsRow">SELECT DISTINCT organization,platform,lifecycle_stage FROM godp_planning_item_read <include refid="scope"/></select>
 <sql id="periodScope">WHERE 1=1
  <if test="startDate!=null and startDate!=''">AND week_start&gt;=#{startWeek}</if>
  <if test="endDate!=null and endDate!=''">AND week_start&lt;=#{endDate}</if>
  <if test="batchQuery!=null and batchQuery!=''">AND (LOCATE(LOWER(#{batchQuery}),LOWER(batch_code))&gt;0 OR CAST(id AS CHAR(32))=#{batchQuery})</if>
 </sql>
 <select id="periodCount" resultType="long">SELECT COUNT(DISTINCT week_start) FROM godp_planning_batch_read <include refid="periodScope"/></select>
 <select id="periodKeys" resultMap="periodKeysRow">SELECT DISTINCT week_start FROM godp_planning_batch_read <include refid="periodScope"/> ORDER BY week_start DESC LIMIT #{limit} OFFSET #{offset}</select>
 <select id="periodBatches" resultMap="periodBatchesRow">SELECT * FROM godp_planning_batch_read <include refid="periodScope"/> AND week_start IN <foreach collection="weeks" item="w" open="(" close=")" separator=",">#{w}</foreach> ORDER BY created_at DESC,id DESC</select>
 <select id="periodAccounts" resultMap="periodAccountsRow">SELECT week_start,COUNT(*) accounts,SUM(has_auto) auto_accounts,SUM(has_manual) manual_accounts,SUM(done) completed_accounts FROM (SELECT b.week_start,i.account_id,MAX(CASE WHEN i.plan_type='auto' THEN 1 ELSE 0 END) has_auto,MAX(CASE WHEN i.plan_type='manual' THEN 1 ELSE 0 END) has_manual,MIN(CASE WHEN i.content_status='generated' THEN 1 ELSE 0 END) done FROM godp_planning_item_read i JOIN godp_planning_batch_read b ON b.id=i.batch_id WHERE b.id IN <foreach collection="ids" item="b" open="(" close=")" separator=",">#{b}</foreach> GROUP BY b.week_start,i.account_id) grouped_accounts GROUP BY week_start</select>
 <sql id="taskScope">WHERE 1=1
  <if test="batch!=null and batch!=''">AND (LOCATE(LOWER(#{batch}),LOWER(task_name))&gt;0 OR LOCATE(LOWER(#{batch}),LOWER(batch_code))&gt;0)</if>
  <if test="creator!=null and creator!=''">AND LOCATE(LOWER(#{creator}),LOWER(created_by))&gt;0</if>
  <if test="dateStart!=null and dateStart!=''">AND publish_date&gt;=#{dateStart}</if>
  <if test="dateEnd!=null and dateEnd!=''">AND publish_date&lt;=#{dateEnd}</if>
  <if test="contentStatus!=null and contentStatus!=''">AND content_status IN <foreach collection="contentStatuses" item="s" open="(" close=")" separator=",">#{s}</foreach></if>
 </sql>
 <select id="taskCount" resultType="long">SELECT COUNT(*) FROM godp_planning_task_read <include refid="taskScope"/></select>
 <select id="tasks" resultMap="tasksRow">SELECT * FROM godp_planning_task_read <include refid="taskScope"/> ORDER BY created_at DESC,row_key DESC LIMIT #{limit} OFFSET #{offset}</select>
 <select id="latestOperations" resultMap="latestOperationsRow">SELECT a.* FROM godp_planning_adjustment a JOIN (SELECT item_id,MAX(id) latest FROM godp_planning_adjustment WHERE del_flag='N' AND item_id IN <foreach collection="ids" item="i" open="(" close=")" separator=",">#{i}</foreach> GROUP BY item_id) x ON a.id=x.latest WHERE a.del_flag='N'</select>
 <select id="failures" resultMap="archivedTaskRow">SELECT f.payload FROM godp_planning_failure f JOIN godp_planning_batch_read b ON b.id=f.batch_id WHERE f.del_flag='N'
  <if test="mode=='batch'">AND b.id=#{batchId}</if>
  <if test="mode=='account'">AND f.account_key=#{accountId}</if>
  <if test="mode=='cycle'">AND b.week_start BETWEEN #{cycleStart} AND #{cycleEnd}</if>
  <if test="planType!=null and planType!='' and planType!='all'">AND b.plan_type=#{planType}</if>
  ORDER BY b.created_at DESC,f.account_key
 </select>
 <select id="archivedTask" resultMap="archivedTaskRow">SELECT payload FROM godp_planning_task_archive WHERE del_flag='N' AND JSON_UNQUOTE(JSON_EXTRACT(payload,'$.task_code'))=#{code} ORDER BY created_at DESC LIMIT 1</select>
</mapper>
