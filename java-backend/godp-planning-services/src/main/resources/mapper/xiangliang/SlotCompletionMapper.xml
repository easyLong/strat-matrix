<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pab.aitmp.aiis.godp.digital.marketing.services.mapper.xiangliang.SlotCompletionMapper">
  <resultMap id="marketingSlotsRow" type="com.pab.aitmp.aiis.godp.digital.marketing.entity.xiangliang.PlanningItemEntity" autoMapping="false">
    <result column="id" property="id"/>
    <result column="del_flag" property="delFlag"/>
    <result column="created_by" property="createdBy"/>
    <result column="updated_by" property="updatedBy"/>
    <result column="created_time" property="createdTime"/>
    <result column="updated_time" property="updatedTime"/>
    <result column="batch_id" property="batchId"/>
    <result column="slot_id" property="slotId"/>
    <result column="account_id" property="accountId"/>
    <result column="publish_date" property="publishDate"/>
    <result column="publish_week" property="publishWeek"/>
    <result column="payload" property="payload"/>
    <result column="content_status" property="contentStatus"/>
    <result column="version" property="version"/>
  </resultMap>

 <select id="hotspotsOnDate" resultMap="marketingSlotsRow">SELECT id,payload,version FROM (<include refid="com.pab.aitmp.aiis.godp.digital.marketing.services.mapper.xiangliang.PlanningQueryMapper.itemRows"/>) itemRows_source WHERE slot_type='hotspot' AND runtime_active='true' AND content_status='unassigned' AND topic_id='' AND publish_date=#{publishDate} AND id&gt;#{after} ORDER BY id LIMIT #{limit}</select>
 <select id="marketingSlots" resultMap="marketingSlotsRow">SELECT id,payload,version FROM (<include refid="com.pab.aitmp.aiis.godp.digital.marketing.services.mapper.xiangliang.PlanningQueryMapper.itemRows"/>) itemRows_source WHERE content_status='awaiting_market' AND id&gt;#{after} ORDER BY id LIMIT #{limit}</select>
 <insert id="claim"><bind name="auditActor" value="@com.pab.aitmp.aiis.godp.digital.marketing.api.xiangliang.context.AuditFields@actor(_parameter, true)"/>INSERT INTO godp_planning_resource_claim(resource_kind,resource_key,item_id,created_by,updated_by) VALUES(#{kind},#{key},#{item},#{auditActor},#{auditActor})</insert>
 <select id="claimed" resultType="long">SELECT COUNT(*) FROM godp_planning_resource_claim WHERE del_flag='N' AND resource_kind=#{kind} AND resource_key=#{key}</select>
 <update id="fill"><bind name="auditActor" value="@com.pab.aitmp.aiis.godp.digital.marketing.api.xiangliang.context.AuditFields@actor(_parameter, false)"/>UPDATE godp_planning_item SET payload=#{payload},content_status=#{status},version=version+1,updated_by=#{auditActor} WHERE del_flag='N' AND id=#{id} AND version=#{expected} AND content_status IN ('unassigned','awaiting_market')</update>
 <select id="contentLinks" resultType="long">SELECT COUNT(*) FROM (<include refid="com.pab.aitmp.aiis.godp.digital.marketing.services.mapper.xiangliang.PlanningQueryMapper.itemRows"/>) itemRows_source WHERE account_id=#{account} AND publish_date BETWEEN #{start} AND #{end} AND topic_type='营销'</select>
</mapper>
