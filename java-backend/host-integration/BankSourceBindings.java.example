package com.pab.aitmp.aiis.godp.digital.marketing.server.xiangliang.config;

import com.pab.aitmp.aiis.godp.digital.marketing.api.xiangliang.port.SourceFacts;
import com.pab.aitmp.aiis.godp.digital.marketing.services.service.xiangliang.source.bank.BankSourceSqlAdapter;
import java.time.ZoneId;
import javax.sql.DataSource;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Profile;
import org.springframework.core.io.ClassPathResource;
import org.springframework.transaction.PlatformTransactionManager;

/** 宿主装配示例：复用宿主数据源和事务管理器，不自行创建连接池，不执行建表。 */
@Configuration("xiangliangBankSourceBindings")
@Profile("inside")
@ConditionalOnProperty(name="planning.host.enabled", havingValue="true")
public class BankSourceBindings {
  @Bean(name="xiangliangBankSourceFacts")
  public SourceFacts bankSourceFacts(
      @Qualifier("xiangliangSourceDataSource") DataSource sourceDataSource,
      @Qualifier("xiangliangSourceTransactions") PlatformTransactionManager sourceTransactions)
      throws Exception {
    // 由宿主注册上述两个 Bean，必须指向同一资料库。
    // XML 放在供应商专属目录；不要同时加载公共占位 XML。
    // 包含账号分页后的 accountInteractions 批量查询，避免逐账号查库。
    return BankSourceSqlAdapter.create(sourceDataSource, sourceTransactions,
        new ClassPathResource("mapper/xiangliang/source/BankSourceMapper.xml"),
        ZoneId.of("Asia/Shanghai"));
  }
}
