package com.stratmatrix.gateway;

import java.util.List;
import com.stratmatrix.gateway.BankContracts.*;

/** Java读取行内资料的预留方法，SQL、鉴权、路径均由行内工程实现。 */
public interface BankDataReader {
    Page<Account> accounts(AccountQuery query);
    Page<Topic> topics(TopicQuery query);
    Page<MarketingContent> marketingContents(MarketingQuery query);
    List<EffectivePlacement> effectiveMarketing(EffectivePlacementQuery query);
    List<ProductionRecord> productionResults(ProductionQuery query);
    List<MarketingProductionRecord> marketingResults(MarketingStatusQuery query);
}
